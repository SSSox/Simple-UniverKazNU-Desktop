{
  "manifest_version": 3,
  "name": "__MSG_name__",
  "short_name": "SimpleUniver",
  "description": "__MSG_description__",
  "version": "0.16.0",
  "default_locale": "ru",
  "author": "SOX Team",
  "homepage_url": "https://sssox.github.io/SimpleUniver/",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_title": "Simple Univer",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "permissions": ["storage"],
  "host_permissions": ["https://univer.kaznu.kz/*"]
}
